{% extends 'base.html.twig' %}

{% block title %}Hackathons{% endblock %}

{% block body %}
    <div>
        <h1>Liste des Hackathons</h1>
        <p><a href="{{ path('app_hackathon_index_json') }}">Version JSON</a></p>

        {% if hackathons is empty %}
            <p>Aucun hackathon trouvé en base de données.</p>
        {% else %}
            <table border="1" cellpadding="5" cellspacing="0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Thème</th>
                        <th>Ville & Lieu</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Projets</th>
                        <th>Thèmes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for hackathon in hackathons %}
                        <tr>
                            <td>{{ hackathon.id }}</td>
                            <td>{{ hackathon.theme }}</td>
                            <td>{{ hackathon.ville }} ({{ hackathon.lieu }})</td>
                            <td>{{ hackathon.dateHeureDebut|date('d/m/Y H:i') }}</td>
                            <td>{{ hackathon.dateHeureFin|date('d/m/Y H:i') }}</td>
                            <td>{{ hackathon.projets|length }} projet(s)</td>
                            <td><a href="{{ path('app_hackathon_show', {id: hackathon.id}) }}">{{ hackathon.theme }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
