{% extends 'base.html.twig' %}

{% block title %}Hackathons{% endblock %}

{% block body %}
    <div>
        <h1>Liste des Hackathons</h1>
        <p><a href="{{ path('app_hackathon_index_json') }}">Version JSON</a></p>

        {% if hackathons is empty %}
            <p>Aucun hackathon trouvé en base de données.</p>
        {% else %}
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Thème</th>
                            <th>Ville & Lieu</th>
                            <th>Début</th>
                            <th>Fin</th>
                            <th>Projets</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for hackathon in hackathons %}
                            <tr>
                                <td class="num">{{ hackathon.id }}</td>
                                <td class="theme"><a href="{{ path('app_hackathon_show', {id: hackathon.id}) }}">{{ hackathon.theme }}</a></td>
                                <td>{{ hackathon.ville }} <span class="num">({{ hackathon.lieu }})</span></td>
                                <td class="date">{{ hackathon.dateHeureDebut|date('d/m/Y H:i') }}</td>
                                <td class="date">{{ hackathon.dateHeureFin|date('d/m/Y H:i') }}</td>
                                <td><span class="badge">{{ hackathon.projets|length }} projet(s)</span></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
